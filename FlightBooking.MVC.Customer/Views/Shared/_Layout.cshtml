<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - حجز تذاكر الطيران</title>
    <style>
        body { font-family: Tahoma, Arial, sans-serif; background:#f4f6f8; margin:0; }
        header { background:#12213b; color:#fff; padding:14px 24px; }
        header a { color:#fff; text-decoration:none; font-weight:bold; }
        main { max-width:960px; margin:24px auto; padding:0 16px; }
        footer { text-align:center; color:#888; padding:24px; font-size:13px; }
    </style>
</head>
<body>
    <header><a asp-controller="Home" asp-action="Index">✈ حجز تذاكر الطيران</a></header>
    <main>
        @RenderBody()
    </main>
    <footer>&copy; @DateTime.Now.Year - Flight Booking Customer Portal</footer>
</body>
</html>
