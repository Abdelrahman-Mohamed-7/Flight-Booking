<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - لوحة تحكم الموظف</title>
    <style>
        body { font-family: Tahoma, Arial, sans-serif; background:#eef1f5; margin:0; }
        header { background:#7a1f2b; color:#fff; padding:14px 24px; }
        header a { color:#fff; text-decoration:none; font-weight:bold; }
        main { max-width:1000px; margin:24px auto; padding:0 16px; }
        table { width:100%; border-collapse:collapse; background:#fff; }
        th, td { padding:10px; border-bottom:1px solid #eee; text-align:right; }
        th { background:#f7f7f9; }
    </style>
</head>
<body>
    <header><a asp-controller="Dashboard" asp-action="Index">🧑‍✈ لوحة تحكم الموظف - إدارة الرحلات</a></header>
    <main>@RenderBody()</main>
</body>
</html>
